@page "/sensors"
@using Application.Models
@attribute [StreamRendering]
@rendermode InteractiveServer

<PageTitle>Sensors</PageTitle>

<h1>Sensors</h1>

<h3>Lights</h3>
<table class="table">
    <thead>
        <tr>
            <th>Topic</th>
            <th>Value</th>
            <th></th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var lightSensor in lightSensors) {
            <tr>
                <td>@lightSensor.Name</td>
                <td>@lightSensor.Status</td>
                <td><button class="btn btn-primary" @onclick="() => TurnLightOn(lightSensor)">Turn On</button></td>
                <td><button class="btn btn-primary" @onclick="() => TurnLightOff(lightSensor)">Turn Off</button></td>
            </tr>
        }
    </tbody>
</table>

<h3>Temperature / Humidity</h3>
<table class="table">
    <thead>
        <tr>
            <th>Topic</th>
            <th>Temperature</th>
            <th>Humidity</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var temperatureSensor in temperatureSensors) {
            <tr>
                <td>@temperatureSensor.Name</td>
                <td>@temperatureSensor.Temperature</td>
                <td>@temperatureSensor.Humidity</td>
            </tr>
        }
    </tbody>
</table>

@code {
    private List<LightSensor> lightSensors;
    private List<TemperatureSensor> temperatureSensors;

    protected override void OnInitialized()
    {
        lightSensors = MqttController.Controller.GetLights();
        temperatureSensors = MqttController.Controller.GetTemperatureSensors();
        updateAfterDelay();
    }
    private void TurnLightOn(LightSensor light)
    {
        light.TurnOnLight();
    }
    private void TurnLightOff(LightSensor light)
    {
        light.TurnOffLight();
    } 
    private async Task updateAfterDelay()
    {
        await Task.Delay(500);
        StateHasChanged();
        _ = updateAfterDelay();
    }
}

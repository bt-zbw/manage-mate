@page "/halls"
@using Microsoft.EntityFrameworkCore
@using Microsoft.AspNetCore.Components.QuickGrid
@using Application.Models
@using Application.Database
@implements IAsyncDisposable
@inject IDbContextFactory<Application.Database.ApplicationDbContext> DbFactory

<PageTitle>Index</PageTitle>

<h1>Index</h1>

<p>
    <a href="halls/create">Create New</a>
</p>

<QuickGrid Class="table" Items="HallsQuery">
    <PropertyColumn Property="hall => hall.Name" />
    <TemplateColumn Title="Address" Context="hall">
        @if (hall.Address != null)
        {
            <span>@($"{hall.Address.Street}, {hall.Address.ZipCode} {hall.Address.City}, {hall.Address.Country}")</span>
        }
        else
        {
            <span>No address</span>
        }
    </TemplateColumn>

    <TemplateColumn Context="hall">
        <a href="@($"halls/edit?id={hall.Id}")">Edit</a> |
        <a href="@($"halls/details?id={hall.Id}")">Details</a> |
        <a href="@($"halls/delete?id={hall.Id}")">Delete</a>
    </TemplateColumn>
</QuickGrid>

@code {
    private ApplicationDbContext context = default!;
    private IQueryable<Hall> HallsQuery { get; set; } = default!;

    protected override void OnInitialized()
    {
        context = DbFactory.CreateDbContext();
        HallsQuery = context.Hall.Include(h => h.Address).AsQueryable();
    }

    public async ValueTask DisposeAsync() => await context.DisposeAsync();
}
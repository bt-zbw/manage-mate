@page "/halls/edit"
@using Microsoft.EntityFrameworkCore
@using Application.Models
@inject IDbContextFactory<Application.Database.ApplicationDbContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Edit</PageTitle>

<h1>Edit</h1>

<h2>Hall</h2>
<hr />
@if (Hall is null)
{
    <p><em>Loading...</em></p>
}
else
{
    <div class="row">
        <div class="col-md-4">
            <EditForm method="post" Model="Hall" OnValidSubmit="UpdateHall" FormName="edit" Enhance>
                <DataAnnotationsValidator />
                <ValidationSummary role="alert" />
                <input type="hidden" name="Hall.Id" value="@Hall.Id" />
                <div class="mb-3">
                    <label for="name" class="form-label">Name:</label>
                    <InputText id="name" @bind-Value="Hall.Name" class="form-control" />
                    <ValidationMessage For="() => Hall.Name" class="text-danger" />
                </div>
                <div class="mb-3">
                    <label for="addressid" class="form-label">Address:</label>
                    <InputSelect id="addressid" class="form-control" @bind-Value="Hall.AddressId">
                        <option value="">Select an address</option>
                        @foreach (var address in Addresses)
                        {
                            <option value="@address.Id">@($"{address.Street}, {address.ZipCode} {address.City}, {address.Country}")</option>
                        }
                    </InputSelect>
                    <ValidationMessage For="() => Hall.AddressId" class="text-danger" />
                </div>
                <button type="submit" class="btn btn-primary">Save</button>
            </EditForm>
        </div>
    </div>
}

<div>
    <a href="/halls">Back to List</a>
</div>

@code {
    [SupplyParameterFromQuery]
    private Guid Id { get; set; }

    [SupplyParameterFromForm]
    private Hall? Hall { get; set; }

    private List<Address> Addresses { get; set; } = new();

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        Addresses = await context.Address.ToListAsync();
        Hall ??= await context.Hall.FirstOrDefaultAsync(m => m.Id == Id);

        if (Hall is null)
        {
            NavigationManager.NavigateTo("notfound");
        }
    }

    private async Task UpdateHall()
    {
        using var context = DbFactory.CreateDbContext();
        context.Attach(Hall!).State = EntityState.Modified;

        try
        {
            await context.SaveChangesAsync();
        }
        catch (DbUpdateConcurrencyException)
        {
            if (!HallExists(Hall!.Id))
            {
                NavigationManager.NavigateTo("notfound");
            }
            else
            {
                throw;
            }
        }

        NavigationManager.NavigateTo("/halls");
    }

    private bool HallExists(Guid id)
    {
        using var context = DbFactory.CreateDbContext();
        return context.Hall.Any(e => e.Id == id);
    }
}

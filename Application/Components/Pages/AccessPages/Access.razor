@page "/access"
@using Application.Database
@using Application.Models
@using Microsoft.EntityFrameworkCore
@inject IDbContextFactory<Application.Database.ApplicationDbContext> DbFactory
@rendermode InteractiveServer

<PageTitle>Access</PageTitle>

<h1>Access</h1>

<h2>Access</h2>
<hr />
<div class="mb-3">
	<label for="halls">Hall:</label>
	<select id="halls" class="form-control" @bind="selectedHallId" @bind:after="OnHallSelected">
		<option value="@Guid.Empty">Select a hall</option>
		@foreach (var hall in Halls) {
			<option value="@hall.Id">@($"{hall.Name} - {hall.Address?.Street}, {hall.Address?.City}")</option>
		}
	</select>
</div>
<div class="mb-3">
	<label for="courts">Court:</label>
	<select id="courts" class="form-control" @bind="selectedCourtId" disabled="@(!hasSelectedHall)">
		<option value="@Guid.Empty">Select a court</option>
		@foreach (var court in Courts) {
			<option value="@court.Id">@($"{court.Name} - {court.Number}")</option>
		}
	</select>
</div>
<div class="mb-3">
	<label for="accesscode">Accesscode:</label>
	<input id="accesscode" class="form-control" type="number" disabled=true @bind="accesscode"/>
</div>
<div class="mb-3">
	<table>
		<tr>
			<td>
				<button @onclick="@(e => accesscode += "7")">7</button>
			</td>
			<td>
				<button @onclick="@(e => accesscode += "8")">8</button>
			</td>
			<td>
				<button @onclick="@(e => accesscode += "9")">9</button>
			</td>
		</tr>
		<tr>
			<td>
				<button @onclick="@(e => accesscode += "4")">4</button>
			</td>
			<td>
				<button @onclick="@(e => accesscode += "5")">5</button>
			</td>
			<td>
				<button @onclick="@(e => accesscode += "6")">6</button>
			</td>
		</tr>
		<tr>
			<td>
				<button @onclick="@(e => accesscode += "1")">1</button>
			</td>
			<td>
				<button @onclick="@(e => accesscode += "2")">2</button>
			</td>
			<td>
				<button @onclick="@(e => accesscode += "3")">3</button>
			</td>
		</tr>
		<tr>
			<td></td>
			<td>
				<button @onclick="@(e => accesscode += "0")">0</button>
			</td>
			<td>
				<button @onclick="@(e => accesscode = accesscode.Length > 0 ? accesscode.Substring(0,(accesscode.Length - 1)) : "")">&lt;</button>
			</td>
		</tr>
	</table>
</div>
<div>
	<button type="submit" class="btn btn-primary" @onclick="CheckAccess">Check Access</button>
</div>

@code {
	private List<Hall> Halls = new();
	private List<Court> Courts = new();

	private string accesscode = "";
	private Guid selectedHallId;
	private Guid selectedCourtId;
	private bool hasSelectedHall => selectedHallId != Guid.Empty;

	protected override async Task OnInitializedAsync() {
		using var context = DbFactory.CreateDbContext();
		Halls = await context.Hall.Include(h => h.Address).ToListAsync();
	}
	private async Task OnHallSelected() {
		using var context = DbFactory.CreateDbContext();
		Courts = await context.Court.Where(c => c.HallId == selectedHallId).ToListAsync();
		selectedCourtId = Guid.Empty;
	}
	private async Task CheckAccess()
	{
		using var context = DbFactory.CreateDbContext();
		var reservations = await context.Reservation.Where(r => (r.Halls.Where(h => h.Id == selectedHallId).Count() > 0) && 
																(r.Courts.Where(c => c.Id == selectedCourtId).Count() >0) &&
																(r.AccessCode == accesscode)
													).CountAsync();
		if (reservations > 0)
		{
			var doors = MqttController.Controller.GetDoorSensors();
			doors[0].OpenDoor();
		}
	}
}
@page "/access"
@using Application.Database
@using Application.Models
@using Microsoft.EntityFrameworkCore
@inject IDbContextFactory<Application.Database.ApplicationDbContext> DbFactory

<PageTitle>Access</PageTitle>

<h1>Access</h1>

<h2>Access</h2>
<hr />
<EditForm Model="res" OnValidSubmit="CheckAccess" FormName="CheckAccess">
	<DataAnnotationsValidator />
	<ValidationSummary />
	<div class="mb-3">
		<label for="hall" class="form-label">Hall:</label>
		<InputSelect
		id="hall"
		class="form-select"
		@bind-Value="res.HallId">
			<option value="">
				Select classification ...
			</option>
			@foreach (var hall in Halls)
			{
				<option 
				checked="@(res.HallId == hall.Id.ToString())"
				value="@hall.Id.ToString()">
					@($"{hall.Name} - {hall.Address?.Street}, {hall.Address?.City}")
				</option>
			}
		</InputSelect>
	</div>
	<div class="mb-3">
		<label for="court" class="form-label">Hall:</label>
		<InputSelect id="court"
		class="form-select"
		@bind-Value="res.CourtId">
			<option value="">
				Select classification ...
			</option>
			@if (Courts.Count > 0) {
				@foreach (var court in Courts) {
					<option checked="@(res.CourtId == court.Id.ToString())"
					value="@court.Id.ToString()">
						@($"{court.Name} - {court.Number}")
					</option>
				}
			}
		</InputSelect>
	</div>
	<div>
		<button type="submit" class="btn btn-primary">Check Access</button>
	</div>
</EditForm>

@code {
	[SupplyParameterFromForm]
	private ReservationCheck res { get; set; } = new();
	private ApplicationDbContext _context { get; set; }

	private List<Hall> Halls => _context.Hall.Include(h => h.Address).ToList();
	private List<Court> Courts => _context.Court.Where(c => c.HallId == Guid.Parse(res.HallId)).ToList();

	protected override async Task OnInitializedAsync() {
		_context = DbFactory.CreateDbContext();
	}

	private void CheckAccess()
	{
		Console.WriteLine("Test");
		Console.WriteLine(res.HallId);
	}

	private class ReservationCheck()
	{
		public Hall Hall { get; set; }
		public string HallId { get; set; } = Guid.Empty.ToString();
		public Court Court { get; set; }
		public string CourtId { get; set; } = Guid.Empty.ToString();
	}
}
@page "/reservations"
@using Microsoft.EntityFrameworkCore
@using Microsoft.AspNetCore.Components.QuickGrid
@using Application.Models
@using Application.Database
@implements IAsyncDisposable
@inject IDbContextFactory<Application.Database.ApplicationDbContext> DbFactory

<PageTitle>Index</PageTitle>

<h1>Index</h1>

<p>
    <a href="reservations/create">Create New</a>
</p>

<QuickGrid Class="table" Items="reservationsQuery">
    <PropertyColumn Property="reservation => reservation.Name" />
    <TemplateColumn Title="Hall" Context="reservation">
        @reservation.Halls.FirstOrDefault()?.Name
    </TemplateColumn>
    <TemplateColumn Title="Court" Context="reservation">
        @reservation.Courts.FirstOrDefault()?.Name
    </TemplateColumn>
    <PropertyColumn Property="reservation => reservation.From" />
    <PropertyColumn Property="reservation => reservation.To" />
    <PropertyColumn Property="reservation => reservation.AccessCode" />

    <TemplateColumn Context="reservation">
        <a href="@($"reservations/edit/{reservation.Id}")">Edit</a> |
        <a href="@($"reservations/details?id={reservation.Id}")">Details</a> |
        <a href="@($"reservations/delete?id={reservation.Id}")">Delete</a>
    </TemplateColumn>
</QuickGrid>

@code {
    private ApplicationDbContext context = default!;
    private IQueryable<Reservation> reservationsQuery = default!;

    protected override void OnInitialized()
    {
        context = DbFactory.CreateDbContext();
        reservationsQuery = context.Reservation
            .Include(r => r.Halls)
            .Include(r => r.Courts)
            .AsQueryable();
    }

    public async ValueTask DisposeAsync() => await context.DisposeAsync();
}
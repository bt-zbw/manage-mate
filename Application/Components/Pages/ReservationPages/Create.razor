@page "/reservations/create"
@using Microsoft.EntityFrameworkCore
@using Application.Models
@inject IDbContextFactory<Application.Database.ApplicationDbContext> DbFactory
@inject NavigationManager NavigationManager
@rendermode InteractiveServer

<PageTitle>Create</PageTitle>

<h1>Create</h1>

<h2>Reservation</h2>
<hr />
<div class="row">
	<div class="col-md-4">
		<EditForm method="post" Model="Reservation" OnValidSubmit="AddReservation" FormName="create" Enhance>
			<DataAnnotationsValidator />
			<ValidationSummary class="text-danger" role="alert" />
			<div class="mb-3">
				<label for="name" class="form-label">Name:</label>
				<InputText id="name" @bind-Value="Reservation.Name" class="form-control" />
				<ValidationMessage For="() => Reservation.Name" class="text-danger" />
			</div>
			<div class="mb-3">
				<label for="description" class="form-label">Description:</label>
				<InputText id="description" @bind-Value="Reservation.Description" class="form-control" />
				<ValidationMessage For="() => Reservation.Description" class="text-danger" />
			</div>

			<div class="mb-3">
				<label for="from" class="form-label">From:</label>
				<InputDate id="from" @bind-Value="Reservation.From" class="form-control" Type="InputDateType.DateTimeLocal"></InputDate>
			</div>
			<div class="mb-3">
				<label for="to" class="form-label">To:</label>
				<InputDate id="to" @bind-Value="Reservation.To" class="form-control" Type="InputDateType.DateTimeLocal"></InputDate>
			</div>
			<div class="mb-3">
				<label for="halls">Hall:</label>
				<select id="halls" class="form-control" @bind="selectedHallId" @bind:after="OnHallSelected">
					<option value="@Guid.Empty">Select a hall</option>
					@foreach (var hall in Halls)
					{
						<option value="@hall.Id">@($"{hall.Name} - {hall.Address?.Street}, {hall.Address?.City}")</option>
					}
				</select>
			</div>
			<div class="mb-3">
				<label for="courts">Court:</label>
				<select id="courts" class="form-control" @bind="selectedCourtId" disabled="@(!hasSelectedHall)">
					<option value="@Guid.Empty">Select a court</option>
					@foreach (var court in Courts)
					{
						<option value="@court.Id">@($"{court.Name} - {court.Number}")</option>
					}
				</select>
			</div>
			<div class="mb-3">
				<label for="users">User:</label>
				<select id="users" class="form-control" @bind="selectedUserId">
					<option value="@Guid.Empty">Select a user</option>
					@foreach (var user in Users) {
						<option value="@user.Id">@($"{user.Firstname} {user.Lastname} ({user.Email})")</option>
					}
				</select>
			</div>
			<div class="mb-3">
				<label for="accesscode" class="form-label">AccessCode:</label>
				<InputText id="accesscode" @bind-Value="Reservation.AccessCode" class="form-control" readonly />
				<ValidationMessage For="() => Reservation.AccessCode" class="text-danger" />
			</div>
			<button type="submit" class="btn btn-primary">Create</button>
		</EditForm>
	</div>
</div>

<div>
	<a href="/reservations">Back to List</a>
</div>

@code {
	[SupplyParameterFromForm]
	private Reservation Reservation { get; set; } = new();

	private List<Hall> Halls = new();
	private List<Court> Courts = new();
	private List<User> Users = new();
	private Guid selectedHallId;
	private Guid selectedCourtId;
	private Guid selectedUserId;
	private bool hasSelectedHall => selectedHallId != Guid.Empty;

	protected override async Task OnInitializedAsync()
	{
		using var context = DbFactory.CreateDbContext();
		Halls = await context.Hall.Include(h => h.Address).ToListAsync();
		Users = await context.User.ToListAsync();

		// Generate a 6-digit access code if not already set
		if (string.IsNullOrWhiteSpace(Reservation.AccessCode))
		{
			Reservation.AccessCode = GenerateAccessCode();
			while (context.Reservation.Where(r => (r.AccessCode == Reservation.AccessCode) && (r.To < DateTime.UtcNow)).Count() > 0) {
				Reservation.AccessCode = GenerateAccessCode();
			}
		}
	}
	private async Task OnHallSelected()
	{
		using var context = DbFactory.CreateDbContext();
		Courts = await context.Court.Where(c => c.HallId == selectedHallId).ToListAsync();
		selectedCourtId = Guid.Empty;
	}
	private static string GenerateAccessCode() {
		var random = new Random();
		return random.Next(100000, 999999).ToString();
	}
	private async Task AddReservation()
	{
		Console.WriteLine(selectedHallId);
		Console.WriteLine(selectedCourtId);
		Console.WriteLine(selectedUserId);
		using var context = DbFactory.CreateDbContext();

		// Set selected halls and courts
		Reservation.Halls = selectedHallId != Guid.Empty ? await context.Hall.Where(h => h.Id == selectedHallId).ToListAsync() : new List<Hall>();
		Reservation.Courts = selectedCourtId != Guid.Empty ? await context.Court.Where(c => c.Id == selectedCourtId).ToListAsync() : new List<Court>();

		// Set the selected user
		Reservation.Users = selectedUserId != Guid.Empty ? await context.User.Where(u => u.Id == selectedUserId).ToListAsync() : new List<User>();

		context.Reservation.Add(Reservation);
		await context.SaveChangesAsync();
		NavigationManager.NavigateTo("/reservations");
	}
	
}
